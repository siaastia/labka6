public class HeapSort {
    // Вспомогательный метод heapify (поддерживает max-heap)
    private static void heapify(int[] arr, int n, int i) {
        int largest = i;            // считаем текущий узел наибольшим
        int left = 2 * i + 1;       // индекс левого потомка
        int right = 2 * i + 2;      // индекс правого потомка

        if (left < n && arr[left] > arr[largest]) { // если левый > текущего
            largest = left;        // обновляем largest
        }
        if (right < n && arr[right] > arr[largest]) { // если правый > текущего/левого
            largest = right;       // обновляем largest
        }
        if (largest != i) {        // если largest изменился — нужно свапнуть и рекурсивно heapify
            int swap = arr[i];     // временная переменная для свапа
            arr[i] = arr[largest];
            arr[largest] = swap;
            heapify(arr, n, largest); // рекурсивный вызов для поддерева
        }
    }

    // Основной метод heap sort
    public static void heapSort(int[] arr) {
        int n = arr.length;         // размер массива
        // строим max-heap
        for (int i = n / 2 - 1; i >= 0; i--) {
            heapify(arr, n, i);     // приводим поддерево в heap-вид
        }
        // по одному извлекаем элементы из heap и ставим в конец массива
        for (int i = n - 1; i > 0; i--) {
            // перемещаем текущий корень (максимум) в конец
            int temp = arr[0];
            arr[0] = arr[i];
            arr[i] = temp;
            // вызываем heapify на уменьшенном heap
            heapify(arr, i, 0);
        }
    }

    // Вспомогательная печать массива
    private static void printArray(int[] arr) {
        for (int v : arr) System.out.print(v + " ");
        System.out.println();
    }

    public static void main(String[] args) {
        int[] arr = {12, 11, 13, 5, 6, 7}; // тестовый массив
        System.out.print("Исходный массив: ");
        printArray(arr);
        heapSort(arr);                     // сортируем
        System.out.print("Отсортированный массив: ");
        printArray(arr);
    }
}
