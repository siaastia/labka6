#include <iostream>                 // подключаем библиотеку ввода-вывода
#include <vector>                   // подключаем контейнер vector для массивоподобной работы
using namespace std;                // используем пространство имен std чтобы писать короче

// Функция selection sort для вектора целых чисел
void selectionSort(vector<int>& arr) { // принимаем массив по ссылке, чтобы менять оригинал
    int n = arr.size();               // определяем размер массива
    for (int i = 0; i < n; ++i) {     // внешний цикл: проходим по всем позициям
        int minIndex = i;             // предполагаем, что текущая позиция — индекс минимального
        for (int j = i + 1; j < n; ++j) { // ищем минимальный элемент в остатке массива
            if (arr[j] < arr[minIndex]) { // если найден элемент меньше текущего минимума
                minIndex = j;         // обновляем индекс минимального
            }
        }
        // меняем текущий элемент с найденным минимальным (если нужны — и когда minIndex != i)
        int temp = arr[i];            // сохраняем значение arr[i] во временную переменную
        arr[i] = arr[minIndex];       // ставим на место i значение минимального
        arr[minIndex] = temp;         // возвращаем сохранённое значение на место minIndex
    }
}

int main() {
    vector<int> a = {64, 25, 12, 22, 11}; // создаём тестовый вектор
    cout << "Исходный массив: ";          // выводим подпись
    for (int x : a) cout << x << " ";     // выводим элементы массива
    cout << "\n";                         // перевод строки
    selectionSort(a);                     // вызываем сортировку выбором
    cout << "Отсортированный массив: ";   // подпись после сортировки
    for (int x : a) cout << x << " ";     // выводим элементы отсортированного массива
    cout << "\n";                         // перевод строки
    return 0;                             // успешное завершение программы
}
